# =============================================================================
# Production template. Committed WITHOUT secrets.
#
# The deploy job copies this file to .env on the runner and, for every KEY
# below, replaces the value with the GitHub repository secret of the SAME NAME
# when that secret exists. Keys without a matching secret keep the value
# written here. GHCR_OWNER and IMAGE_TAG are appended by the workflow.
# See docs/deployment-secrets in the ops bundle for the full list.
# =============================================================================

# --- General ------------------------------------------------------------------
APP_ENV=production
SITE_URL=https://sonychristanto.com
SECURITY_CONTACT=mailto:cs@bidtech.co.id

# --- PostgreSQL (container on the internal compose network) -------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=sony
POSTGRES_PASSWORD=__SECRET__
POSTGRES_DB=sonychristanto
POSTGRES_SSLMODE=disable

# --- Backend --------------------------------------------------------------------
BACKEND_PORT=8080
JWT_SECRET=__SECRET__
JWT_TTL_HOURS=12
AUTH_COOKIE_NAME=sc_session
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_DOMAIN=
# Docker networks + localhost (nginx on the host reaches the backend via 127.0.0.1)
TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12,10.0.0.0/8,192.168.0.0/16

# Used only on the very first boot (empty admins table) to create the superadmin.
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=__SECRET__
SEED_ADMIN_PASSWORD=__SECRET__

# --- Object storage: RustFS service in this compose project ----------------------
# S3_ACCESS_KEY / S3_SECRET_KEY are also RustFS's root credentials
# (RUSTFS_ACCESS_KEY / RUSTFS_SECRET_KEY in docker-compose.yml).
S3_ENDPOINT=rustfs:9000
S3_ACCESS_KEY=__SECRET__
S3_SECRET_KEY=__SECRET__
S3_BUCKET=sonychristanto
S3_REGION=us-east-1
S3_USE_SSL=false

# --- Uploads --------------------------------------------------------------------
UPLOAD_MAX_MB=10
IMAGE_MAX_WIDTH=1920
IMAGE_MAX_HEIGHT=1080
IMAGE_QUALITY=80

# --- ISR revalidation -------------------------------------------------------------
REVALIDATE_SECRET=__SECRET__

# --- Cloudflare purge after publish (optional) ------------------------------------
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# --- Frontend ---------------------------------------------------------------------
# Google Tag Manager container (also passed as a build arg so prerendered pages include it).
NUXT_PUBLIC_GTM_ID=GTM-5FC5K5DH

# --- Host ports (bound to 127.0.0.1 only) -----------------------------------------
FRONTEND_HOST_PORT=3070
BACKEND_HOST_PORT=8070
RUSTFS_CONSOLE_HOST_PORT=9011
