# =============================================================================
# Local development. Copy to .env:   cp .env.example .env
# Values here are for localhost only — never reuse them in production.
# Production keys live in .env.prod.example (filled from GitHub secrets).
# =============================================================================

# --- General ------------------------------------------------------------------
APP_ENV=development
SITE_URL=http://localhost:3000
SECURITY_CONTACT=mailto:security@sonychristanto.com

# --- PostgreSQL -----------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=sony
POSTGRES_PASSWORD=sony_dev_password
POSTGRES_DB=sonychristanto
POSTGRES_SSLMODE=disable

# --- Backend (Go) ---------------------------------------------------------------
BACKEND_PORT=8080
# min. 32 chars; generate with: openssl rand -base64 48
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
JWT_TTL_HOURS=12
AUTH_COOKIE_NAME=sc_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_DOMAIN=

# First account, created only when the admins table is empty. It becomes the superadmin.
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@sonychristanto.local
SEED_ADMIN_PASSWORD=admin12345

# --- Object storage (RustFS, S3-compatible) -------------------------------------
S3_ENDPOINT=rustfs:9000
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_BUCKET=sonychristanto
S3_REGION=us-east-1
S3_USE_SSL=false

# --- Uploads (images -> WebP) ---------------------------------------------------
UPLOAD_MAX_MB=10
IMAGE_MAX_WIDTH=1920
IMAGE_MAX_HEIGHT=1080
IMAGE_QUALITY=80

# --- ISR revalidation (backend -> frontend) --------------------------------------
REVALIDATE_SECRET=dev-revalidate-secret

# --- Cloudflare cache purge after publish (optional; empty = disabled) -----------
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# --- Frontend -------------------------------------------------------------------
# Google Tag Manager — leave empty in development so local visits are not tracked.
NUXT_PUBLIC_GTM_ID=
